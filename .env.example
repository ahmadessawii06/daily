# Local development works without MongoDB. Data is saved in data/accounts.json.
PORT=3000
# Required on Vercel, Netlify, and in production. Never commit real credentials.
MONGODB_URI=
# At least 32 random characters. Locally, a secret is generated and persisted.
JWT_SECRET=
# Optional local database directory; use one Node process with the JSON store.
DATA_DIR=

# Password reset email (server-side only; never use a VITE_ prefix).
# Use the public origin of this deployment; HTTPS is required in production.
APP_URL=https://daily-ten-rose.vercel.app
RESEND_API_KEY=
# A sender on a verified Resend domain, e.g. Mizan <support@example.com>.
RESET_EMAIL_FROM=
